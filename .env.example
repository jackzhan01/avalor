# AI 功能的配置。复制成 .env.local 再填，.env.local 不会进 git。
#
# 只有 /api/ai 这一个服务端路由读得到这些值，它们永远不会进浏览器的 bundle。
# 不配 OPENAI_API_KEY 的话，App 其余部分照常可用，只有两个 AI 按钮会报「服务端还没配置」。

# 必填。https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxxxxx

# 可选。换模型只要改这一行，代码不用动。
AI_MODEL=gpt-5.4-mini

# 可选。任何 OpenAI 兼容的服务都行（DeepSeek、Qwen、自建 vLLM 等），
# 填到 /v1 为止，不要带 /chat/completions。
# AI_BASE_URL=https://api.openai.com/v1


# ---------------------------------------------------------------------------
# 账号与配额
#
# 这三个值全空时：登录页会说「没接后端」，AI 按钮报「用不了」，
# 记录本身完全不受影响 —— 本地优先是这个 App 的地基，不因为加了后端而改变。
#
# Supabase 后台 → Project Settings → API 里抄。
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxx

# ⚠️ 绕过所有行级权限，等于数据库的完整权限。
# 只有服务端读得到（没有 NEXT_PUBLIC_ 前缀），绝不能贴进任何客户端代码。
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxx


# ---------------------------------------------------------------------------
# 花钱的闸门
# ---------------------------------------------------------------------------

# 全局熔断。出事的时候把这一个值改成 false，重新部署即可全站停用 AI。
# 注意只认字符串 "false"，留空或拼错都视为开启。
AI_ENABLED=true

# 模型单价，美元 / 每百万 token，去你的服务商价目表抄当前值。
# 这两个值不填，AI 功能会直接停用 —— 算不出花了多少钱的预算不叫预算。
AI_PRICE_IN_PER_M=0.25
AI_PRICE_OUT_PER_M=2.00

# 全站月度硬上限（美元）。按 UTC 自然月统计，超了就停到下个月，不会自动放宽。
AI_MONTHLY_BUDGET_USD=50

# 单个用户每天的调用次数上限（按 UTC 日）。
AI_DAILY_REQUESTS=20
