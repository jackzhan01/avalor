{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vbench:layout",
  "type": "object",
  "required": [
    "schema",
    "layout_id",
    "frame_size",
    "regions"
  ],
  "properties": {
    "schema": {
      "const": "vbench.layout/1"
    },
    "layout_id": {
      "type": "string",
      "minLength": 1
    },
    "frame_size": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "minItems": 2,
      "maxItems": 2
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "regions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "visibility",
          "rect"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "kind": {
            "enum": [
              "caption",
              "speaker_label",
              "board",
              "roster",
              "camera",
              "other"
            ]
          },
          "visibility": {
            "enum": [
              "public",
              "private",
              "excluded"
            ],
            "description": "Only public regions ever reach public extraction. Private regions are only readable by the private-label command. Excluded regions are read by nobody."
          },
          "rect": {
            "$ref": "vbench:common#/$defs/rect"
          },
          "masks": {
            "type": "array",
            "items": {
              "$ref": "vbench:common#/$defs/rect"
            },
            "description": "Sub-rectangles (absolute source pixels) blanked inside this region before any consumer sees it."
          },
          "why": {
            "type": "string"
          },
          "presence": {
            "type": "object",
            "required": [
              "hsv_lo",
              "hsv_hi",
              "min_fraction"
            ],
            "properties": {
              "hsv_lo": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                },
                "minItems": 3,
                "maxItems": 3
              },
              "hsv_hi": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                },
                "minItems": 3,
                "maxItems": 3
              },
              "min_fraction": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "edge_band_px": {
                "type": "integer",
                "minimum": 1,
                "description": "Measure only the top and bottom bands of this height, where overlay text never reaches."
              },
              "requires": {
                "type": "string",
                "description": "Region id that must also be present in the same frame (label box is part of the subtitle overlay)."
              },
              "method": {
                "enum": [
                  "hsv_fraction",
                  "outlined_text"
                ]
              },
              "requires_absent": {
                "type": "string",
                "description": "Region id that must NOT be present (bar-less subtitles exist only when the bar is absent)."
              },
              "black_v_max": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              "dilate_px": {
                "type": "integer",
                "minimum": 1
              },
              "requires_any": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "At least one of these regions must be present (the label box accompanies either subtitle style)."
              }
            },
            "additionalProperties": false,
            "description": "Overlay presence gate: fraction of pixels inside the OpenCV HSV range. When absent, the rect shows camera content and is never OCR'd."
          },
          "guard_period_s": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "diff": {
            "type": "object",
            "properties": {
              "thumb_scale": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              },
              "pixel_threshold": {
                "type": "integer",
                "minimum": 1,
                "maximum": 255
              },
              "fraction_threshold": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              },
              "signal": {
                "enum": [
                  "gray",
                  "outlined_text_mask"
                ]
              }
            },
            "additionalProperties": false,
            "description": "Per-region override of the pilot sampling diff parameters (small board text vanishes in a 1/4-scale thumbnail)."
          },
          "ocr_mode": {
            "enum": [
              "line",
              "page",
              "page2x"
            ]
          },
          "redact": {
            "type": "object",
            "required": [
              "mode"
            ],
            "properties": {
              "mode": {
                "enum": [
                  "keep_first_ink_run"
                ]
              },
              "ink_v_max": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              "gap_px": {
                "type": "integer",
                "minimum": 1
              },
              "max_run_px": {
                "type": "integer",
                "minimum": 1
              },
              "pad_px": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false,
            "description": "Drop answer-bearing pixels the rect cannot avoid enclosing. Applied after the presence gate and before OCR, diffing, cache keys and saved crops."
          },
          "cells": {
              "type": "object",
              "description": "Per-board vote-cell calibration. Geometry (seat1_x, cell_dx, strip_dy) and, for method 'cell_background', the HSV bands. Measured per source: boards do not share a cell pitch or a vote encoding.",
              "properties": {
                "method": { "enum": ["digit_ink", "cell_background"] },
                "seat1_x": { "type": "number" },
                "cell_dx": { "type": "number", "exclusiveMinimum": 0 },
                "strip_dy": { "type": "number" },
                "half_w": { "type": "integer", "minimum": 1 },
                "half_h": { "type": "integer", "minimum": 1 },
                "bg_value_max": { "type": "integer", "minimum": 0, "maximum": 255 },
                "min_pixels": { "type": "integer", "minimum": 1 },
                "approve_hue": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
                "reject_sat_min": { "type": "number" },
                "warm_hue_max": { "type": "number" },
                "warm_hue_min": { "type": "number" }
              },
              "additionalProperties": false
            },
            "parser": {
            "enum": [
              "board",
              "client_log"
            ],
            "description": "Which reader turns this region's OCR into missions. Default 'board' (offline round-table板); 'client_log' for the online client's history panel."
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
