{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vbench:sample_y_v2",
  "type": "object",
  "required": [
    "schema",
    "sample_id",
    "draft",
    "targets",
    "coverage",
    "scoring_mode",
    "evidence_refs",
    "constraint_checks",
    "roster_verification"
  ],
  "properties": {
    "schema": {
      "const": "vbench.sample_y/2"
    },
    "sample_id": {
      "type": "string",
      "pattern": "^x2-[0-9a-f]{16}$"
    },
    "draft": {
      "type": "boolean"
    },
    "targets": {
      "type": "object",
      "required": [
        "roles"
      ],
      "properties": {
        "roles": {
          "type": "object",
          "propertyNames": {
            "pattern": "^(10|[1-9])$"
          },
          "additionalProperties": {
            "type": "object",
            "required": [
              "role",
              "verification"
            ],
            "properties": {
              "role": {
                "type": "string"
              },
              "side": {
                "enum": [
                  "good",
                  "evil",
                  "unknown"
                ]
              },
              "verification": {
                "enum": [
                  "verified",
                  "candidate",
                  "unknown"
                ]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "required": [
        "verified_seats",
        "total_seats"
      ],
      "properties": {
        "verified_seats": {
          "type": "integer",
          "minimum": 0
        },
        "total_seats": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "scoring_mode": {
      "enum": [
        "full",
        "partial",
        "none"
      ]
    },
    "evidence_refs": {
      "type": "array"
    },
    "constraint_checks": {
      "type": "null",
      "description": "Reserved. Not populated with guessed reasoning annotations in v1."
    },
    "roster_verification": {
      "type": "object"
    }
  },
  "additionalProperties": false
}