{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vbench:batch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "batch_id",
    "jobs"
  ],
  "properties": {
    "schema": {
      "const": "vbench.batch/1"
    },
    "batch_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "device": {
      "enum": [
        "cpu",
        "cuda"
      ]
    },
    "jobs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "config",
          "run_id"
        ],
        "properties": {
          "config": {
            "type": "string",
            "minLength": 1
          },
          "run_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "description": "Resource floors for this batch, frozen at init. Omitted keys use DEFAULT_LIMITS; a run cannot lower them afterwards.",
      "properties": {
        "download_need_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "download_headroom_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "extract_memory_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "extract_vram_mib": {
          "type": "integer",
          "minimum": 0
        },
        "backlog_max_items": {
          "type": "integer",
          "minimum": 0
        },
        "backlog_max_bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  }
}
