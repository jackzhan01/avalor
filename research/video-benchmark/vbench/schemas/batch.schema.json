{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vbench:batch",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "batch_id", "jobs"],
  "properties": {
    "schema": {"const": "vbench.batch/1"},
    "batch_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "device": {"enum": ["cpu", "cuda"]},
    "jobs": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false, "required": ["config", "run_id"],
      "properties": {"config": {"type": "string", "minLength": 1},
                     "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"}}
    }}
  }
}
