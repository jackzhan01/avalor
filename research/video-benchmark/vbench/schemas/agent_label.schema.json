{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vbench:agent_label",
  "description": "Scoring answer for one input document. Never sent with the input; opened separately.",
  "type": "object",
  "required": [
    "schema",
    "sample_id",
    "input_sha256",
    "seats",
    "role_enum",
    "side_enum",
    "optional_targets",
    "scoring",
    "notes"
  ],
  "properties": {
    "schema": {
      "const": "vbench.agent_label/1"
    },
    "sample_id": {
      "type": "string",
      "minLength": 1
    },
    "input_sha256": {
      "$ref": "vbench:common#/$defs/sha256"
    },
    "draft": {
      "type": "boolean"
    },
    "seats": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(10|[1-9])$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "role",
          "side",
          "verification"
        ],
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "side": {
            "enum": [
              "good",
              "evil",
              "unknown"
            ]
          },
          "verification": {
            "enum": [
              "verified",
              "candidate",
              "unknown"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "role_enum": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "side_enum": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "optional_targets": {
      "type": "object",
      "required": [
        "assassin_seat",
        "assassination_target_seat",
        "assassination_hit",
        "winning_side"
      ],
      "properties": {
        "assassin_seat": {
          "$ref": "vbench:common#/$defs/seat_or_null"
        },
        "assassination_target_seat": {
          "$ref": "vbench:common#/$defs/seat_or_null"
        },
        "assassination_hit": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "winning_side": {
          "enum": [
            "good",
            "evil",
            null
          ]
        }
      },
      "additionalProperties": false
    },
    "scoring": {
      "type": "object",
      "required": [
        "primary",
        "mode",
        "verified_seats",
        "total_seats"
      ],
      "properties": {
        "primary": {
          "const": "seat_roles"
        },
        "mode": {
          "enum": [
            "full",
            "partial",
            "none"
          ]
        },
        "verified_seats": {
          "type": "integer",
          "minimum": 0
        },
        "total_seats": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "derived_from": {
      "type": [
        "object",
        "null"
      ],
      "description": "This label scores a document DERIVED from another sample (an input ablation). Same seats, same scoring rule; only the input bytes differ, so the hash binding has to point back at what it came from.",
      "required": [
        "sample_id",
        "input_sha256",
        "condition"
      ],
      "properties": {
        "sample_id": {
          "type": "string",
          "minLength": 1
        },
        "input_sha256": {
          "$ref": "vbench:common#/$defs/sha256"
        },
        "condition": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
