{
  "simulatorVersion": "sim-0.2.0",
  "promptVersion": "prompt-0.2.0",
  "playerCount": 10,

  "model": {
    "id": "gpt-5.6-terra",
    "reasoningEffort": "high",
    "params": {}
  },

  "cognition": {
    "enabled": false,
    "mode": "fused",
    "maxCognitionRepairs": 2,
    "telemetry": true
  },

  "stages": {
    "$comment": [
      "两阶段（私有规划者 / 公开发言者）的模型配置。",
      "只有 promptVersion 是 prompt-0.5.0 时才起作用，别的版本这一段完全没人读。",
      "",
      "全部字段默认 null = 继承 model / limits。写死一个模型 id 会让今天写的",
      "profile 在顶层模型换掉的那天变得不可复现；把三个值都设成必填又会逼每个",
      "profile 重复它并不关心的东西。继承让「同一个模型跑两段」是零行配置，",
      "让「混合两个模型」明确写出差在哪。",
      "",
      "这里不出现任何供应商名字：一段就是 模型 id + 思考强度 + 输出上限。"
    ],
    "planner": { "model": null, "reasoningEffort": null, "maxOutputTokens": null },
    "spokesperson": { "model": null, "reasoningEffort": null, "maxOutputTokens": null },
    "maxPublicMessageRepairs": 1
  },

  "limits": {
    "maxStandardInputTokens": 250000,
    "maxOutputTokens": 12000,
    "speechCharLimit": 220,
    "maxActionsPerGame": 4000,
    "maxLiveCallsPerGame": 600
  },

  "budget": {
    "costWarningPerGameUsd": 12,
    "hardCostLimitPerGameUsd": 25,
    "hardBatchCostLimitUsd": 100
  },

  "pricing": {
    "configured": true,
    "modelId": "gpt-5.6-terra",
    "sourceUrl": "https://developers.openai.com/api/docs/models/gpt-5.6-terra",
    "verifiedOn": "2026-08-23",
    "pricingVersion": "gpt-5.6-terra@2026-08-23",
    "uncachedInputUsdPerMTok": 2.0,
    "cachedInputUsdPerMTok": 0.2,
    "outputUsdPerMTok": 12.0
  },

  "smoke": {
    "ceilingUsd": 0.1,
    "maxOutputTokens": 1000,
    "assumedInputTokens": 500,
    "pessimisticInputUsdPerMTok": 20,
    "pessimisticOutputUsdPerMTok": 80
  },

  "experiment": {
    "personaMode": "heterogeneous-rotated",
    "strategyProfile": "baseline"
  },

  "run": {
    "concurrency": 1,
    "maxRetries": 2
  }
}
